# Beatbump stack configuration. `./up.sh` copies this file to deploy/.env on first
# run and fills in the three secrets; edit deploy/.env afterwards, never this file.
# Relative paths are resolved from the deploy/ directory.

# ---- Where the app listens --------------------------------------------------
# Host port published for the app (the only published port of the stack).
BEATBUMP_PORT=8080
# Host address to bind (0.0.0.0 = every interface, 127.0.0.1 = this machine only).
BEATBUMP_BIND=0.0.0.0

# ---- Secrets (generated by ./up.sh, hex) -------------------------------------
# Meilisearch master key (>= 16 chars); also used by beatbump, bridge and indexer.
MEILI_MASTER_KEY=
# Shared secret between beatbump and invidious-companion. EXACTLY 16 characters.
COMPANION_SECRET_KEY=
# Bearer token for the operator-only endpoints (GET /api/v1/client-log ...).
YTM_ADMIN_TOKEN=

# ---- Library ---------------------------------------------------------------
# Your music folder (read-only for the app). Downloads go to MUSIC_DIR/ytm.
# `./up.sh --sample-library` fills an empty MUSIC_DIR with MUSIC_DIR/sample.
MUSIC_DIR=./data/music
# Which top-level folders of MUSIC_DIR to index: "*" = all of them (plus loose files
# at the root), or an explicit list such as "ytm,lidarr,soulseek".
INDEXER_SOURCES=*
# Seconds between two library scans (new files are only visible after a scan).
INDEXER_SCAN_INTERVAL=300

# ---- Ownership of ./data (containers run as this uid:gid) ---------------------
# ./up.sh sets them to the user running it (1000:1000 when run as root).
PUID=1000
PGID=1000

# ---- Behaviour -------------------------------------------------------------
# Enqueue a yubal download of what you play when it is not in the library yet.
BEATBUMP_AUTOCACHE=true
# Max albums/playlists auto-acquired per day (0 = unlimited).
YTM_ACQUIRE_DAILY_CAP=20
# Contact shown on the stats page for library reports (optional).
YTM_REPORT_EMAIL=
# Version string reported by /api/v1/stats/library and baked into the image.
BEATBUMP_VERSION=dev
# Timezone used by yubal's scheduler.
TZ=UTC
# Download codec for yubal (opus recommended; m4a/mp3/flac also accepted by yubal).
YUBAL_AUDIO_FORMAT=opus
# Log level of yubal (DEBUG, INFO, WARNING).
YUBAL_LOG_LEVEL=INFO

# ---- Optional egress / integrations (all off by default) ---------------------
# HTTP proxy for every YouTube-facing call (companion, bgutil, yubal, bridge /vp,
# beatbump background lookups), e.g. http://user:pass@proxy:8080. Empty = direct.
EGRESS_PROXY=
# Logged-in player sidecar (iv-vp protocol) used when the anonymous companion is
# walled. Empty = disabled; audio stays on the app's /vp proxy.
IVVP_UPSTREAM=
# Invidious instance behind the bridge's /iv/* routes (only the ytify client uses
# them). Empty = /iv/* answers 502.
INVIDIOUS_UPSTREAM=
# invidious-companion image (pin a tag here if `latest` misbehaves).
COMPANION_IMAGE=quay.io/invidious/invidious-companion:latest
