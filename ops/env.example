# ops/env.example: a coherent example of a production layout for the ops scripts: one checkout per role,
# a reverse proxy on 127.0.0.1:443 whose public names do not hairpin from the host, a dedicated image name,
# a staging instance next to production. Copy it to ops/env.local (git-ignored, sourced by env.sh on every
# run) and put your real values there; never commit them. Every variable is documented in env.sh.
# Or use it as a whole for one shell:   set -a; . ops/env.example; set +a
YTM_ROOT=/srv/beatbump
YTM_SRC_DIR=/srv/beatbump/agents/integration
YTM_PROD_URL=https://music.example.org
YTM_STAGING_URL=https://staging.music.example.org
YTM_RESOLVE_IP=127.0.0.1
YTM_PROD_CONTAINER=beatbump-beatbump-1
YTM_STAGING_CONTAINER=beatbump-staging-beatbump-1
YTM_COMPOSE_SERVICE=beatbump
YTM_IMAGE=beatbump-local
YTM_COMPOSE_FILE=/srv/beatbump/docker-compose.yml
YTM_COMPOSE_PROJECT=
YTM_COMPOSE_ENV_FILE=/srv/beatbump/.env
YTM_STAGING_COMPOSE=/srv/beatbump/agents/staging-compose.yml
YTM_STAGING_PROJECT=beatbump-staging
YTM_DATA_DIR=/srv/beatbump
YTM_DB_DIR=/srv/beatbump/beatbump-db
YTM_STAGING_DB_DIR=/srv/beatbump/agents/staging-db
YTM_IMAGE_BACKUPS=/srv/beatbump/image-backups
YTM_BACKUP_PREFIX=beatbump-prod
YTM_SECRETS_ENV_FILE=/srv/beatbump/beatbump.env
YTM_HEALTHCHECK_LABEL=fr.ekaii.ytm.healthcheck
YTM_E2E_DIR=/srv/beatbump/e2e
YTM_PROGRAM_DIR=/srv/beatbump/agents/program
YTM_LOG_DIR=/tmp
YTM_BUILD_LOCK=/tmp/beatbump-build.lock
YTM_QUERY="daft punk"
HARNESS_RESOLVER="MAP *.example.org 127.0.0.1"
HARNESS_RESOLVE_IP=127.0.0.1
YTM_LIBRARY_DIR=/mnt/music
YTM_ACQ_CONTAINER=beatbump-yubal-1
YTM_ACQ_MOUNT=/app/data
YTM_DISK_PATHS="/srv /mnt/music"
YTM_KUMA_CONTAINER=kuma
YTM_KUMA_MONITORS="1 2 3"
YTM_KUMA_STATS_MONITOR=3
# The production compose file already names its image and has its own staging compose: no ops overrides.
YTM_COMPOSE_OVERRIDE=
YTM_STAGING_OVERRIDE=
YTM_STAGING_ENV_FILE=/srv/beatbump/.env
# Production plays every harness step: a SKIP line is a failure of the target, not an accepted state.
YTM_ALLOW_SKIPS=0
# Optional page-view analytics of the build (an Umami-compatible script; the shipped app has none by default).
YTM_ANALYTICS_SRC=https://analytics.example.org/script.js
YTM_ANALYTICS_WEBSITE_ID=00000000-0000-0000-0000-000000000000
YTM_ANALYTICS_HOST=https://analytics.example.org

# ---- Production layout parity: compose environment of the services (NOT ops variables) -----------------
# The shipped bridge, yubal and Go server default to GENERIC behaviour (no egress proxy, no iv-vp, no
# invidious, same-origin /vp audio). A production that relies on a proxy / iv-vp / invidious setup keeps it
# only if ITS compose file (YTM_COMPOSE_FILE) sets, on the services below, the values it needs. promote.sh
# never strips them: it only adds / keeps the healthcheck block, wires the env_file and removes a clear-text
# COMPANION_SECRET_KEY line. Check them before the first promotion from this repository (ops/README.md,
# "Before the first promotion from this repository"). Example values (service names on the compose network):
#   bridge:    GOST_PROXY=http://egress-proxy:8888    (empty = direct egress for /vp and /iv/videoplayback)
#              IVVP_UPSTREAM=http://iv-vp:5007        (empty = no logged-in fallback)
#              INVIDIOUS_UPSTREAM=http://invidious:3000   (empty = /iv/* answers 502)
#              VP_PUBLIC_BASE=https://ytify.example.org/vp
#              AUD_PUBLIC_BASE=https://invidious.example.org/aud
#              LOCALF_PUBLIC_BASE=/localf             (read by bridge/bridge.py; prod serves /localf same-origin)
#   yubal:     YTM_YTDLP_PROXY=http://egress-proxy:8888   (empty = direct yt-dlp egress)
#   beatbump:  RESIDENTIAL_PROXY=http://egress-proxy:8888 (empty = direct egress for the InnerTube "next" lookups)
#              YTM_PREFER_IVVP_AUDIO=1                (audio through /aud/<id> when IVVP_URL is set)
#              IVVP_URL=http://iv-vp:5007, LOCALF_BASE=/localf, COVER_BASE=/cover
