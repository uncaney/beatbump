# ops/env.example: the values that reproduce the original production layout of music.ekaii.fr on the box
# `docker-host` (one checkout per role, Traefik on 127.0.0.1:443 with a broken hairpin, image beatbump-ekaii).
# Use it as a whole:   set -a; . /srv/beatbump/agents/ship/ops/env.example; set +a
# or copy it to ops/env.local (git-ignored, sourced by env.sh) and edit. Every variable is documented in env.sh.
YTM_ROOT=/srv/beatbump
YTM_SRC_DIR=/srv/beatbump/agents/integration
YTM_PROD_URL=https://music.ekaii.fr
YTM_STAGING_URL=https://staging-music.ekaii.fr
YTM_RESOLVE_IP=127.0.0.1
YTM_PROD_CONTAINER=ytm-beatbump
YTM_STAGING_CONTAINER=ytm-beatbump-staging
YTM_COMPOSE_SERVICE=beatbump
YTM_IMAGE=beatbump-ekaii
YTM_COMPOSE_FILE=/srv/beatbump/docker-compose.yml
YTM_COMPOSE_PROJECT=
YTM_COMPOSE_ENV_FILE=/srv/beatbump/.env
YTM_STAGING_COMPOSE=/srv/beatbump/agents/staging-compose.yml
YTM_STAGING_PROJECT=ytm-staging
YTM_DATA_DIR=/srv/beatbump
YTM_DB_DIR=/srv/beatbump/beatbump-db
YTM_STAGING_DB_DIR=/srv/beatbump/agents/staging-db
YTM_IMAGE_BACKUPS=/srv/beatbump/image-backups
YTM_BACKUP_PREFIX=beatbump-prod
YTM_SECRETS_ENV_FILE=/srv/beatbump/beatbump.env
YTM_HEALTHCHECK_LABEL=fr.ekaii.ytm.healthcheck
YTM_E2E_DIR=/srv/beatbump/e2e
YTM_PROGRAM_DIR=/srv/beatbump/agents/program
YTM_LOG_DIR=/tmp
YTM_BUILD_LOCK=/tmp/beatbump-build.lock
YTM_QUERY="daft punk"
HARNESS_RESOLVER="MAP *.ekaii.fr 127.0.0.1, MAP *.example.org 127.0.0.1"
HARNESS_RESOLVE_IP=127.0.0.1
YTM_LIBRARY_DIR=/mnt/nas/media/music/ytm
YTM_ACQ_CONTAINER=ytm-yubal
YTM_ACQ_MOUNT=/app/data
YTM_DISK_PATHS=/srv/data
YTM_KUMA_CONTAINER=uptime-kuma
YTM_KUMA_MONITORS="86 119 106 167"
YTM_KUMA_STATS_MONITOR=167
# The production compose file already names its image and has its own staging compose: no ops overrides.
YTM_COMPOSE_OVERRIDE=
YTM_STAGING_OVERRIDE=
YTM_STAGING_ENV_FILE=/srv/beatbump/.env
# Production plays every harness step: a SKIP line is a failure of the target, not an accepted state.
YTM_ALLOW_SKIPS=0

# ---- Camille's production layout: compose environment parity (NOT ops variables) --------------------------
# The shipped bridge, yubal and Go server default to GENERIC behaviour (no egress proxy, no iv-vp, no
# invidious, same-origin /vp audio). The original production keeps its behaviour only if ITS compose file
# (YTM_COMPOSE_FILE) sets, on the services below, the values it used to carry. promote.sh never strips them:
# it only adds / keeps the healthcheck block, wires the env_file and removes a clear-text COMPANION_SECRET_KEY
# line. Check them before the first promotion from this repository (ops/README.md, "Before the first
# promotion from this repository"):
#   bridge:    GOST_PROXY=http://gost:8888            (empty = direct egress for /vp and /iv/videoplayback)
#              IVVP_UPSTREAM=http://iv-vp:5007        (empty = no logged-in fallback)
#              INVIDIOUS_UPSTREAM=http://invidious-app-t2s:3000   (empty = /iv/* answers 502)
#              VP_PUBLIC_BASE=https://ytify.ekaii.fr/vp
#              AUD_PUBLIC_BASE=https://invidious.ekaii.fr/aud
#              LOCALF_PUBLIC_BASE=/localf             (read by bridge/bridge.py; prod serves /localf same-origin)
#   yubal:     YTM_YTDLP_PROXY=http://gost:8888       (empty = direct yt-dlp egress)
#   beatbump:  RESIDENTIAL_PROXY=http://gost:8888     (empty = direct egress for the InnerTube "next" lookups)
#              YTM_PREFER_IVVP_AUDIO=1                (audio through /aud/<id> when IVVP_URL is set)
#              IVVP_URL=http://iv-vp:5007, LOCALF_BASE=/localf, COVER_BASE=/cover (already in the prod compose)
