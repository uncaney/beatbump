# ops/env.example: the values that reproduce the original production layout of music.ekaii.fr on the box
# `docker-host` (one checkout per role, Traefik on 127.0.0.1:443 with a broken hairpin, image beatbump-ekaii).
# Use it as a whole:   set -a; . /srv/beatbump/agents/ship/ops/env.example; set +a
# or copy it to ops/env.local (git-ignored, sourced by env.sh) and edit. Every variable is documented in env.sh.
YTM_ROOT=/srv/beatbump
YTM_SRC_DIR=/srv/beatbump/agents/integration
YTM_PROD_URL=https://music.ekaii.fr
YTM_STAGING_URL=https://staging-music.ekaii.fr
YTM_RESOLVE_IP=127.0.0.1
YTM_PROD_CONTAINER=ytm-beatbump
YTM_STAGING_CONTAINER=ytm-beatbump-staging
YTM_COMPOSE_SERVICE=beatbump
YTM_IMAGE=beatbump-ekaii
YTM_COMPOSE_FILE=/srv/beatbump/docker-compose.yml
YTM_COMPOSE_PROJECT=
YTM_COMPOSE_ENV_FILE=/srv/beatbump/.env
YTM_STAGING_COMPOSE=/srv/beatbump/agents/staging-compose.yml
YTM_STAGING_PROJECT=ytm-staging
YTM_DATA_DIR=/srv/beatbump
YTM_DB_DIR=/srv/beatbump/beatbump-db
YTM_STAGING_DB_DIR=/srv/beatbump/agents/staging-db
YTM_IMAGE_BACKUPS=/srv/beatbump/image-backups
YTM_BACKUP_PREFIX=beatbump-prod
YTM_SECRETS_ENV_FILE=/srv/beatbump/beatbump.env
YTM_HEALTHCHECK_LABEL=fr.ekaii.ytm.healthcheck
YTM_E2E_DIR=/srv/beatbump/e2e
YTM_PROGRAM_DIR=/srv/beatbump/agents/program
YTM_LOG_DIR=/tmp
YTM_BUILD_LOCK=/tmp/beatbump-build.lock
YTM_QUERY="daft punk"
HARNESS_RESOLVER="MAP *.ekaii.fr 127.0.0.1, MAP *.example.org 127.0.0.1"
HARNESS_RESOLVE_IP=127.0.0.1
YTM_LIBRARY_DIR=/mnt/nas/media/music/ytm
YTM_ACQ_CONTAINER=ytm-yubal
YTM_ACQ_MOUNT=/app/data
YTM_DISK_PATHS=/srv/data
YTM_KUMA_CONTAINER=uptime-kuma
YTM_KUMA_MONITORS="86 119 106 167"
YTM_KUMA_STATS_MONITOR=167
